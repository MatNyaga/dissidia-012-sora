{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dissidia012-sora/pkg/patches.schema.json#1.0",
  "title": "patches/<owner_tables code-site id>.json, format 1.0",
  "description": "Code edits for ONE code site (docs/PACKAGE-FORMAT.md section 8). Word edits: va 4-aligned, old/new = the 32-bit little-endian word value as 0x%08x. Byte edits: old_bytes/new_bytes hex of equal length; old_bytes null only with append=true (bytes past the image's clean end, e.g. the battle overlay cave). Sorted by (image, va), no overlaps.",
  "type": "object",
  "required": ["edits", "format_version", "set", "site"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "site": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "set": {"type": "string", "pattern": "^(owner[0-9]{1,3}|engine|generic)$"},
    "layouts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["A", "B"]}},
    "note": {"type": "string"},
    "edits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edit"}}
  },
  "$defs": {
    "word": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
    "hex": {"type": "string", "pattern": "^([0-9a-f]{2})+$"},
    "edit": {
      "type": "object",
      "required": ["image", "va"],
      "additionalProperties": false,
      "properties": {
        "image": {"enum": ["EBOOT", "OVL_MENU_APP", "OVL_BATTLE_APP"]},
        "va": {"$ref": "#/$defs/word"},
        "old": {"$ref": "#/$defs/word"},
        "new": {"$ref": "#/$defs/word"},
        "old_bytes": {"oneOf": [{"$ref": "#/$defs/hex"}, {"type": "null"}]},
        "new_bytes": {"$ref": "#/$defs/hex"},
        "append": {"type": "boolean"},
        "note": {"type": "string"}
      },
      "oneOf": [
        {"required": ["old", "new"]},
        {"required": ["old_bytes", "new_bytes"]}
      ]
    }
  }
}
